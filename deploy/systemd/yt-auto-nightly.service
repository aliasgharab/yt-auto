[Unit]
Description=yt-auto nightly: build Shorts from Notion ideas, QA, ask for approval, publish
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/yt-auto
Environment=PATH=%h/.local/bin:%h/projects/yt-auto/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Nice=10
IOSchedulingClass=idle
ExecStart=%h/projects/yt-auto/.venv/bin/yt-auto nightly
TimeoutStartSec=4h
