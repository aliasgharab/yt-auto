[Unit]
Description=yt-auto weekly: research new ideas, refresh stats, rewrite What Works
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/yt-auto
Environment=PATH=%h/.local/bin:%h/projects/yt-auto/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Nice=10
ExecStart=-%h/projects/yt-auto/.venv/bin/yt-auto research
ExecStart=-%h/projects/yt-auto/.venv/bin/yt-auto stats
ExecStart=%h/projects/yt-auto/.venv/bin/yt-auto analyze
TimeoutStartSec=2h
